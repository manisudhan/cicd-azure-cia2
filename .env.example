# Template only. Copy to .env and fill in; .env is git-ignored so nothing here
# is ever committed. Gitleaks will fail the build if a real secret is committed.
#
#   cp .env.example .env
#
# Then edit .env and set a password of your own before "docker compose up".

# ---- Local Jenkins controller (docker-compose.yml) ----
# The admin account created on first boot by jenkins/init.groovy.d.
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=change-me-to-something-random

# ---- Application runtime (optional, for a local "docker run") ----
# In Kubernetes these come from the ConfigMap instead.
APP_RELEASE_MESSAGE=Running locally with docker run
APP_ENVIRONMENT=local
APP_IMAGE_TAG=local
APP_BUILD_NUMBER=local
APP_COMMIT_SHA=local
