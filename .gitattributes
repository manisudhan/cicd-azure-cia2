# Normalise line endings. Shell scripts and the Maven wrapper MUST be LF or they
# fail on the Linux build agent with "bad interpreter: No such file or directory".
* text=auto eol=lf

*.sh      text eol=lf
mvnw      text eol=lf
Jenkinsfile text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.java    text eol=lf
*.xml     text eol=lf
*.toml    text eol=lf
*.properties text eol=lf
Dockerfile   text eol=lf

*.cmd     text eol=crlf
*.bat     text eol=crlf

*.png binary
*.jpg binary
*.jar binary
*.docx binary
